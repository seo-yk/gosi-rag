# Embedding (검색)
# 인덱스 생성(src/indexing.py), 검색 평가, 앱이 모두 이 두 값을 쓴다.
# 인덱스 폴더는 모델 이름으로 정해진다: index/faq_v2/<모델 이름> (예: index/faq_v2/kure-v1)
# Options: local (sentence-transformers), openai
EMBEDDING_PROVIDER=local
# local 예: intfloat/multilingual-e5-small, BAAI/bge-m3, nlpai-lab/KURE-v1
# openai 예: text-embedding-3-small, text-embedding-3-large
EMBEDDING_MODEL=BAAI/bge-m3

# 앱·생성 단계의 검색 구성
# 기본값은 검색 실험(docs/retrieval_pipeline.md 9장)에서 고른 bge-m3 + row + title_body
# CHUNKING_MODE: row(FAQ 1개 단위), sentence(문장 단위)
# EMBEDDING_MODE: title(제목만), title_body(제목+본문). sentence는 title_body만 지원
CHUNKING_MODE=row
EMBEDDING_MODE=title_body
TOP_K=3
# 인덱스 폴더를 직접 지정할 때만 사용 (비우면 index/faq_v2/<모델 이름>)
INDEX_DIR=

# Generation (답변 생성)
# Options: openai, gemini, ollama
# 기본값은 생성 실험 A 조건의 모델이다(docs/generation_results.md). OPENAI_API_KEY가 필요하다
GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-5.4-mini
# Ollama 예(실험 C): GENERATION_PROVIDER=ollama, GENERATION_MODEL=exaone3.5-7.8b-ctx8k
# 기본 컨텍스트(2,048토큰) 모델은 입력이 한도에 닿으면 생성을 멈춘다. evaluation/ollama/*.Modelfile로 8K 모델을 만들어 쓴다
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama 접속 주소
OLLAMA_BASE_URL=http://localhost:11434/v1
# Docker 앱 컨테이너에서 Ollama에 접속할 주소(docker-compose.yml에서만 사용)
# compose의 ollama 컨테이너: 비워 두면 http://ollama:11434/v1
# 호스트(맥)에서 실행 중인 Ollama: http://host.docker.internal:11434/v1
DOCKER_OLLAMA_BASE_URL=

# 1차 실험 채점(evaluation/scripts/evaluate_generation.py, 루브릭 v1)에서만 사용
# 재실험 채점(judge_answers.py)은 --judge-provider gemini와 GEMINI_API_KEY를 쓴다
EVALUATION_PROVIDER=ollama
EVALUATION_MODEL=gemma3:4b
