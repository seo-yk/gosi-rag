# Embedding
# Use local for a quick run without OpenAI API credentials.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNKING_MODE=row
EMBEDDING_MODE=title
TOP_K=3

# Generation
# Options: gemini, openai, ollama
# The default below avoids external API credentials, but requires Ollama to be running.
GENERATION_PROVIDER=ollama
GENERATION_MODEL=qwen2.5:3b
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama is used for local generation/evaluation.
OLLAMA_BASE_URL=http://localhost:11434/v1
EVALUATION_PROVIDER=ollama
EVALUATION_MODEL=gemma3:4b
