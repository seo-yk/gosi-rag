# Embedding (검색)
# 인덱스 생성(src/indexing.py), 검색 평가, 앱이 모두 이 두 값을 쓴다.
# 인덱스 폴더는 모델 이름으로 정해진다: index/faq_v2/<모델 이름> (예: index/faq_v2/kure-v1)
# Options: local (sentence-transformers), openai
EMBEDDING_PROVIDER=local
# local 예: intfloat/multilingual-e5-small, BAAI/bge-m3, nlpai-lab/KURE-v1
# openai 예: text-embedding-3-small, text-embedding-3-large
EMBEDDING_MODEL=BAAI/bge-m3

# 앱·생성 단계의 검색 구성
# 기본값은 검색 실험(docs/retrieval_pipeline.md 9장)에서 고른 bge-m3 + row + title_body
# CHUNKING_MODE: row(FAQ 1개 단위), sentence(문장 단위)
# EMBEDDING_MODE: title(제목만), title_body(제목+본문). sentence는 title_body만 지원
CHUNKING_MODE=row
EMBEDDING_MODE=title_body
TOP_K=3
# 인덱스 폴더를 직접 지정할 때만 사용 (비우면 index/faq_v2/<모델 이름>)
INDEX_DIR=

# Generation
# Options: gemini, openai, ollama
# The default below avoids external API credentials, but requires Ollama to be running.
GENERATION_PROVIDER=ollama
GENERATION_MODEL=qwen2.5:3b
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama is used for local generation/evaluation.
OLLAMA_BASE_URL=http://localhost:11434/v1
EVALUATION_PROVIDER=ollama
EVALUATION_MODEL=gemma3:4b
